{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "astral-dev",
  "version": "0.7.2-dev",
  "identifier": "dev.astral-php.astral-dev",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "astral-dev", "width": 1200, "height": 760, "minWidth": 900, "minHeight": 600, "visible": false }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "astral-php",
    "shortDescription": "Environnement de développement local pour Astral PHP",
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["French", "English"], "displayLanguageSelector": false, "installerHooks": "installer-hooks.nsh" } }
  }
}
